# ==============================================================================
# Document Verification Authority Dashboard - Environment Configuration
# ==============================================================================
# Copy this file to '.env' before running the application:
#   cp .env.example .env (Linux / macOS / Git Bash)
#   copy .env.example .env (Windows Command Prompt)
# ==============================================================================

# Backend API Base URL
# The dashboard sends document metadata records (Aadhaar, Document ID, type, hash)
# to this API endpoint after successfully issuing on the Ethereum blockchain.

# Option 1: Local Backend server (e.g. FastAPI, Node/Express, Django, Flask)
REACT_APP_API_URL=http://localhost:8000/api

# Option 2: Public ngrok tunnel or deployed backend (uncomment and replace with your URL)
# REACT_APP_API_URL=https://your-ngrok-subdomain.ngrok-free.dev
